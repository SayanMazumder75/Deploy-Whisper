# Port the Node/Express server listens on. Render auto-injects PORT.
PORT=5000

# MongoDB connection string. Use MongoDB Atlas in production
# (e.g. mongodb+srv://user:pass@cluster.mongodb.net/meeting-recorder).
MONGO_URI=mongodb://localhost:27017/meeting-recorder

# Comma-separated list of allowed client origins. Add your Vercel URL here.
# Example: https://your-app.vercel.app,https://your-app-git-main.vercel.app
CLIENT_URL=http://localhost:3000

# URL of the Python FastAPI Whisper service (deployed separately on Render).
WHISPER_SERVICE_URL=http://localhost:8000

# Groq API key for LLM-based summary generation.
GROQ_API_KEY=your_groq_api_key_here
