# Port the FastAPI service listens on. Render auto-injects PORT.
PORT=8000

# Whisper model size: tiny | base | small | medium | large-v3
# - tiny:  ~75MB  on disk, fastest, lowest accuracy
# - base:  ~140MB on disk, good for low-RAM hosts (Render Starter)
# - small: ~244MB on disk, default; needs >=1GB RAM at runtime
WHISPER_MODEL=small

# "cpu" (default) or "cuda" if you have GPU.
WHISPER_DEVICE=cpu

# "int8" for CPU (default), "float16"/"float32" for GPU.
WHISPER_COMPUTE=int8

# Comma-separated allowed CORS origins, or "*" to allow any.
# In production, restrict to your Node server URL.
CORS_ORIGINS=*
